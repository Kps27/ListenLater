{
  "name": "listen-later",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:api": "npm run dev -w @listen-later/api",
    "dev:web": "python3 -m http.server 8765",
    "dev:app": "npm run dev -w @listen-later/web",
    "test": "node --test apps/api/test/*.test.js lib/*.test.js",
    "dev": "concurrently -n api,app,proto -c blue,magenta,green \"npm run dev:api\" \"npm run dev:app\" \"npm run dev:web\""
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
