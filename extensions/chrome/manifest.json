{
  "manifest_version": 3,
  "name": "Listen Later",
  "version": "0.1.0",
  "description": "Send the page you are reading to your Listen Later queue (client_text path).",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["http://127.0.0.1:3333/*", "http://localhost:3333/*"],
  "action": {
    "default_title": "Save to Listen Later"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
